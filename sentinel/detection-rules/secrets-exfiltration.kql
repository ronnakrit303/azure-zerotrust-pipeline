// Tactic: Exfiltration | Technique: T1552
// Detects high-volume Key Vault secret/key/certificate reads and backup operations.
let Lookback = 1d;
let Window = 15m;
let SecretOperationThreshold = 20;
let VaultThreshold = 2;
let SensitiveOperations = dynamic([
    "SecretGet",
    "SecretList",
    "SecretBackup",
    "KeyGet",
    "KeyList",
    "KeyBackup",
    "CertificateGet",
    "CertificateList",
    "CertificateBackup",
    "secrets/read",
    "secrets/list",
    "secrets/backup",
    "keys/read",
    "keys/list",
    "keys/backup",
    "certificates/read",
    "certificates/list",
    "certificates/backup"
]);
let VaultDiagnosticEvents =
    AzureDiagnostics
    | where TimeGenerated >= ago(Lookback)
    | where tostring(column_ifexists("ResourceProvider", "")) =~ "MICROSOFT.KEYVAULT"
        or tostring(column_ifexists("ResourceProvider", "")) =~ "MICROSOFT.KEYVAULT/VAULTS"
    | extend
        Operation = tostring(column_ifexists("OperationName", "")),
        Result = tostring(column_ifexists("ResultType", "")),
        UserPrincipalName = tostring(column_ifexists("identity_claim_upn_s", "")),
        AppId = tostring(column_ifexists("identity_claim_appid_g", "")),
        ObjectId = tostring(column_ifexists("identity_claim_http_schemas_microsoft_com_identity_claims_objectidentifier_g", "")),
        Caller = tostring(column_ifexists("Caller", "")),
        CallerIPAddress = tostring(column_ifexists("CallerIPAddress", "")),
        CallerIpAddress = tostring(column_ifexists("CallerIpAddress", "")),
        CallerIpAddressAlt = tostring(column_ifexists("callerIpAddress_s", ""))
    | where Operation has_any (SensitiveOperations)
    | extend
        AccountName = case(
            isnotempty(UserPrincipalName), UserPrincipalName,
            isnotempty(AppId), AppId,
            isnotempty(ObjectId), ObjectId,
            isnotempty(Caller), Caller,
            "Unknown"
        ),
        IPAddress = case(
            isnotempty(CallerIPAddress), CallerIPAddress,
            isnotempty(CallerIpAddress), CallerIpAddress,
            isnotempty(CallerIpAddressAlt), CallerIpAddressAlt,
            "Unknown"
        ),
        VaultResource = tostring(column_ifexists("Resource", ""))
    | project TimeGenerated, AccountName, IPAddress, Operation, Result, VaultResource;
let VaultActivityEvents =
    AzureActivity
    | where TimeGenerated >= ago(Lookback)
    | where tostring(column_ifexists("ResourceProviderValue", "")) =~ "MICROSOFT.KEYVAULT"
    | extend
        Operation = tostring(column_ifexists("OperationNameValue", "")),
        Result = tostring(column_ifexists("ActivityStatusValue", "")),
        Caller = tostring(column_ifexists("Caller", "")),
        CallerIp = tostring(column_ifexists("CallerIpAddress", ""))
    | where Operation has_any (SensitiveOperations)
    | extend
        AccountName = iff(isnotempty(Caller), Caller, "Unknown"),
        IPAddress = iff(isnotempty(CallerIp), CallerIp, "Unknown"),
        VaultResource = tostring(column_ifexists("ResourceId", ""))
    | project TimeGenerated, AccountName, IPAddress, Operation, Result, VaultResource;
union isfuzzy=true VaultDiagnosticEvents, VaultActivityEvents
| summarize
    OperationCount = count(),
    VaultCount = dcount(VaultResource),
    OperationSet = make_set(Operation, 20),
    ResultSet = make_set(Result, 10),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by AccountName, IPAddress, TimeWindow = bin(TimeGenerated, Window)
| where OperationCount >= SecretOperationThreshold
    or VaultCount >= VaultThreshold
    or tostring(OperationSet) has_any ("SecretBackup", "KeyBackup", "CertificateBackup", "secrets/backup", "keys/backup", "certificates/backup")
| extend
    TimeGenerated = LastSeen,
    Action = strcat(
        "High-volume Key Vault sensitive object access: ",
        tostring(OperationCount),
        " operations across ",
        tostring(VaultCount),
        " vault resource(s). Operations=",
        tostring(OperationSet)
    ),
    Severity = case(
        OperationCount >= 50 or VaultCount >= 3 or tostring(OperationSet) has_any ("SecretBackup", "KeyBackup", "CertificateBackup", "secrets/backup", "keys/backup", "certificates/backup"),
        "High",
        "Medium"
    )
| project
    TimeGenerated,
    AccountName,
    IPAddress,
    Action,
    Severity,
    OperationCount,
    VaultCount,
    OperationSet,
    ResultSet,
    FirstSeen,
    LastSeen
| order by TimeGenerated desc
