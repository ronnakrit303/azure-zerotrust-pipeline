{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "type": "string",
      "allowedValues": [
        "dev",
        "prod"
      ],
      "defaultValue": "dev",
      "metadata": {
        "description": "Deployment environment name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "southeastasia",
      "metadata": {
        "description": "Azure region for the policy assignment managed identity."
      }
    },
    "locationShort": {
      "type": "string",
      "defaultValue": "sea",
      "metadata": {
        "description": "Short Azure region code used in default assignment and initiative names."
      }
    },
    "policySetDefinitionName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing custom initiative name. Leave empty to use azzt-cis-{environment}."
      }
    },
    "assignmentName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Policy assignment name. Leave empty to use azzt-cis-{environment}."
      }
    },
    "enforcementMode": {
      "type": "string",
      "allowedValues": [
        "Default",
        "DoNotEnforce"
      ],
      "defaultValue": "DoNotEnforce",
      "metadata": {
        "description": "Assignment enforcement mode. Use DoNotEnforce while validating audit results."
      }
    },
    "tagEffect": {
      "type": "string",
      "allowedValues": [
        "audit",
        "modify",
        "disabled"
      ],
      "defaultValue": "audit",
      "metadata": {
        "description": "Current tag policy effect. Role assignment and remediation are only created when this is modify."
      }
    },
    "notScopes": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Optional scopes to exclude from the assignment."
      }
    },
    "createRemediationTasks": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set true to create remediation tasks for the tag policy references."
      }
    },
    "tagPolicyDefinitionReferenceIds": {
      "type": "array",
      "defaultValue": [
        "enforce-tag-1",
        "enforce-tag-2",
        "enforce-tag-3",
        "enforce-tag-4"
      ],
      "metadata": {
        "description": "Initiative reference IDs for tag policies that can be remediated."
      }
    },
    "remediationLocations": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Optional location filters for remediation tasks."
      }
    }
  },
  "variables": {
    "effectivePolicySetDefinitionName": "[if(empty(parameters('policySetDefinitionName')), format('azzt-cis-{0}-{1}', parameters('environment'), parameters('locationShort')), parameters('policySetDefinitionName'))]",
    "effectiveAssignmentName": "[if(empty(parameters('assignmentName')), format('azzt-cis-{0}-{1}', parameters('environment'), parameters('locationShort')), parameters('assignmentName'))]",
    "assignmentResourceId": "[subscriptionResourceId('Microsoft.Authorization/policyAssignments', variables('effectiveAssignmentName'))]",
    "tagContributorRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4a9ae827-6dc8-4573-8ac7-8239d42aa03f')]",
    "tagContributorRoleAssignmentName": "[guid(subscription().id, variables('effectiveAssignmentName'), variables('tagContributorRoleDefinitionId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyAssignments",
      "apiVersion": "2022-06-01",
      "name": "[variables('effectiveAssignmentName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "displayName": "[format('AZZT - CIS Azure Benchmark Zero Trust baseline ({0})', parameters('environment'))]",
        "description": "Assigns the custom Zero Trust policy initiative at subscription scope. The initiative is created by policy/main.bicep.",
        "enforcementMode": "[parameters('enforcementMode')]",
        "policyDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/policySetDefinitions', variables('effectivePolicySetDefinitionName'))]",
        "notScopes": "[parameters('notScopes')]",
        "metadata": {
          "version": "1.0.0",
          "category": "Security",
          "assignedBy": "ARM template",
          "source": "azure-zerotrust-pipeline",
          "cisBenchmark": "CIS Microsoft Azure Foundations Benchmark v2.0.0"
        },
        "nonComplianceMessages": [
          {
            "policyDefinitionReferenceId": "deny-public-ip",
            "message": "Public IP address resources are not allowed for this Zero Trust baseline."
          },
          {
            "policyDefinitionReferenceId": "require-https",
            "message": "Supported services must require HTTPS-only access."
          },
          {
            "policyDefinitionReferenceId": "enforce-tag-1",
            "message": "Resource must include the required project tag."
          },
          {
            "policyDefinitionReferenceId": "enforce-tag-2",
            "message": "Resource must include the required workload tag."
          },
          {
            "policyDefinitionReferenceId": "enforce-tag-3",
            "message": "Resource must include the required environment tag."
          },
          {
            "policyDefinitionReferenceId": "enforce-tag-4",
            "message": "Resource must include the required managedBy tag."
          }
        ]
      }
    },
    {
      "condition": "[equals(parameters('tagEffect'), 'modify')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('tagContributorRoleAssignmentName')]",
      "dependsOn": [
        "[variables('assignmentResourceId')]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('tagContributorRoleDefinitionId')]",
        "principalId": "[reference(variables('assignmentResourceId'), '2022-06-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[and(parameters('createRemediationTasks'), equals(parameters('tagEffect'), 'modify'))]",
      "copy": {
        "name": "tagRemediationTasks",
        "count": "[length(parameters('tagPolicyDefinitionReferenceIds'))]"
      },
      "type": "Microsoft.PolicyInsights/remediations",
      "apiVersion": "2021-10-01",
      "name": "[format('remediate-{0}-{1}', variables('effectiveAssignmentName'), parameters('tagPolicyDefinitionReferenceIds')[copyIndex()])]",
      "dependsOn": [
        "[variables('assignmentResourceId')]",
        "[subscriptionResourceId('Microsoft.Authorization/roleAssignments', variables('tagContributorRoleAssignmentName'))]"
      ],
      "properties": {
        "policyAssignmentId": "[variables('assignmentResourceId')]",
        "policyDefinitionReferenceId": "[parameters('tagPolicyDefinitionReferenceIds')[copyIndex()]]",
        "resourceDiscoveryMode": "ReEvaluateCompliance",
        "filters": {
          "locations": "[parameters('remediationLocations')]"
        }
      }
    }
  ],
  "outputs": {
    "policyAssignmentResourceId": {
      "type": "string",
      "value": "[variables('assignmentResourceId')]"
    }
  }
}
