{
  "$schema": "https://schema.management.azure.com/schemas/2020-09-01/policyDefinition.json#",
  "properties": {
    "displayName": "AZZT - Enforce required resource tag",
    "policyType": "Custom",
    "description": "Audits or remediates a required tag value on taggable resources by using Azure Policy modify.",
    "mode": "Indexed",
    "metadata": {
      "version": "1.0.0",
      "category": "Governance",
      "source": "azure-zerotrust-pipeline",
      "cisControls": [
        "CIS Microsoft Azure Foundations Benchmark v2.0.0 - supporting governance metadata for compliance evidence"
      ]
    },
    "parameters": {
      "tagName": {
        "type": "String",
        "metadata": {
          "displayName": "Tag name",
          "description": "Name of the tag to require or remediate."
        }
      },
      "tagValue": {
        "type": "String",
        "metadata": {
          "displayName": "Tag value",
          "description": "Required value for the tag."
        }
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Use audit to test, modify to enforce and remediate, or disabled to turn off the policy."
        },
        "allowedValues": [
          "audit",
          "modify",
          "disabled"
        ],
        "defaultValue": "audit"
      }
    },
    "policyRule": {
      "if": {
        "anyOf": [
          {
            "field": "[concat('tags[', parameters('tagName'), ']')]",
            "exists": "false"
          },
          {
            "field": "[concat('tags[', parameters('tagName'), ']')]",
            "notEquals": "[parameters('tagValue')]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "conflictEffect": "audit",
          "roleDefinitionIds": [
            "/providers/microsoft.authorization/roleDefinitions/4a9ae827-6dc8-4573-8ac7-8239d42aa03f"
          ],
          "operations": [
            {
              "operation": "addOrReplace",
              "field": "[concat('tags[', parameters('tagName'), ']')]",
              "value": "[parameters('tagValue')]"
            }
          ]
        }
      }
    }
  }
}
